; FsmKit lab: a tiny project that runs the kit's own example and tests, apart from any game.
; addons/fsm_kit is a symlink to the kit's own addons/fsm_kit (one copy of the kit).

config_version=5

[application]

config/name="FsmKit Lab"
run/main_scene="res://addons/fsm_kit/examples/minimal_2d/minimal_2d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/fsm_kit/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
