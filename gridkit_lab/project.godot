; GridKit lab: a tiny project that runs the kit's own example and tests, apart from any game.
; addons/grid_kit is a symlink to the kit's own addons/grid_kit (one copy of the kit).

config_version=5

[application]

config/name="GridKit Lab"
run/main_scene="res://addons/grid_kit/examples/minimal_3d/minimal_3d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/grid_kit/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
