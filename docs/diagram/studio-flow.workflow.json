  "cards": [
    {
      "dot": "cyan",
      "title": "The interview",
      "items": [
        "Clean or standard, which multiplayer, 2D or 3D",
        "Art with the Aseprite or Blender MCP, and Material Maker, only with your OK",
        "Like in X: the orchestrator researches it (web, decompiling) and writes the sources on F n"
      ]
    },
    {
      "dot": "violet",
      "title": "If you ask for them",
      "items": [
        "Tester: tests, if you ask or RULES requires them",
        "Visual: a UI pass, with VISUAL.md",
        "Playtester: the godot-studio-playtest module; without it, a manual checklist"
      ]
    },
    {
      "dot": "amber",
      "title": "After the report",
      "items": [
        "Broken criterion, or the PNG shows something else: developer, one fix",
        "res://debug already shows the result: reviewer (the scene cheats)",
        "Cache or a CLI that did not run: one --import and the playtester runs again",
        "res://debug is missing (NEED_SETUP): the orchestrator finishes the plan",
        "The cut or the scene was planned wrong: tech lead"
      ]
    },
    {
      "dot": "emerald",
      "title": "Done when",
      "items": [
        "The project parses headless",
        "gdformat and gdlint pass, if the project uses them",
        "The scene runs with F6 and F n is up to date"
      ]
    }
  ]
