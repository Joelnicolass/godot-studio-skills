  "edges": [
    { "id": "idea-interview", "from": "idea", "to": "interview", "variant": "default" },
    { "id": "interview-feature", "from": "interview", "to": "feature", "label": "stack chosen", "variant": "emphasis" },
    { "id": "feature-lead", "from": "feature", "to": "lead", "variant": "default" },
    { "id": "lead-ok", "from": "lead", "to": "ok", "label": "tree: more / fewer pieces?", "variant": "security" },
    { "id": "ok-dev", "from": "ok", "to": "dev", "label": "approved", "variant": "emphasis" },
    { "id": "dev-review", "from": "dev", "to": "review", "variant": "default" },
    { "id": "review-close", "from": "review", "to": "close", "label": "no blockers", "variant": "emphasis" },
    { "id": "review-passes", "from": "review", "to": "passes", "label": "if you agree", "variant": "dashed", "role": "branch" },
    { "id": "passes-close", "from": "passes", "to": "close", "variant": "dashed", "role": "return" }
