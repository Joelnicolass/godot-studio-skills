; RtsKit lab: a tiny project that runs the kit's own examples and tests, apart from any game.
; addons/rts_kit is a symlink to the kit's own addons/rts_kit (one copy of the kit).

config_version=5

[application]

config/name="RtsKit Lab"
run/main_scene="res://addons/rts_kit/examples/skirmish_3d/skirmish_3d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/rts_kit/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="units"
2d_physics/layer_2="units"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
