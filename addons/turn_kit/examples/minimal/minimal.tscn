[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://addons/turn_kit/examples/minimal/minimal.gd" id="1_main"]
[ext_resource type="Script" path="res://addons/turn_kit/nodes/turn_clock.gd" id="2_clock"]
[ext_resource type="Script" path="res://addons/turn_kit/nodes/turn_seat.gd" id="3_seat"]

[node name="Minimal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -120.0
offset_right = 200.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="Status" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Box"]
layout_mode = 2
alignment = 1

[node name="Spend" type="Button" parent="Box/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Spend action"

[node name="NextPhase" type="Button" parent="Box/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Next phase"

[node name="End" type="Button" parent="Box/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "End turn"

[node name="Log" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Turns" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_clock")
rounds_per_cycle = 2
cycles = 2
first_seat_rotates = true
phases = Array[StringName]([&"draw", &"play"])
turn_seconds = 10.0

[node name="Ana" type="Node" parent="Turns"]
script = ExtResource("3_seat")
display_name = "Ana"

[node name="Beto" type="Node" parent="Turns"]
script = ExtResource("3_seat")
display_name = "Beto"

[node name="Bot" type="Node" parent="Turns"]
script = ExtResource("3_seat")
display_name = "Bot"
is_bot = true
