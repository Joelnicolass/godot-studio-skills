[sub_resource type="BoxShape3D" id="BoxShape3D_ground"]
size = Vector3(120, 1, 120)

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(120, 120)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ground"]
albedo_color = Color(0.32, 0.42, 0.26, 1)

[sub_resource type="Environment" id="Environment_sky"]
background_mode = 1
background_color = Color(0.55, 0.68, 0.82, 1)
ambient_light_source = 2
ambient_light_color = Color(0.8, 0.82, 0.9, 1)
ambient_light_energy = 0.6

[node name="Skirmish3D" type="Node3D"]
editor_description = "RtsKit's 3D example. Rig: the kit's command rig (rts_command_rig_3d.tscn) with its Camera, Ground and Menu sockets assigned; Editable Children is on to give State its cues, to set the same-kind radius (Selection) and to wire the HUD to the pieces. Units: spawned by the script (RtsUnit + RtsExampleWalker). Hud comes after the rig, so its controls keep their clicks."
script = ExtResource("1_main")

[node name="Environment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_sky")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, 0.866, 0, -0.866, 0.5, 0, 20, 0)

[node name="Ground" type="StaticBody3D" parent="."]
collision_mask = 0

[node name="Shape" type="CollisionShape3D" parent="Ground"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
shape = SubResource("BoxShape3D_ground")

[node name="Mesh" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("PlaneMesh_ground")
surface_material_override/0 = SubResource("StandardMaterial3D_ground")

[node name="Units" type="Node3D" parent="."]

[node name="Camera" type="Camera3D" parent="." node_paths=PackedStringArray("ground")]
current = true
script = ExtResource("2_camera")
ground = NodePath("../Ground")
free_pitch_deg = 58.0
free_min_distance = 12.0
free_max_distance = 70.0
bounds = Rect2(-60, -60, 120, 120)
start_zoom = 0.35

[node name="Ping" type="Node3D" parent="." node_paths=PackedStringArray("order_input")]
script = ExtResource("3_ping")
order_input = NodePath("../Rig/Command/OrderInput")

[node name="Rig" parent="." node_paths=PackedStringArray("camera", "ground", "menu") instance=ExtResource("20_rig")]
camera = NodePath("../Camera")
ground = NodePath("../Ground")
menu = NodePath("../Hud/RadialMenu")

[node name="Selection" parent="Rig/Command" index="0"]
same_type_radius = 30.0

[node name="State" parent="Rig/Command" index="3"]
cues = SubResource("Resource_cues")

[node name="Hud" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="Hud"]
unique_name_in_owner = true
offset_left = 16.0
offset_top = 12.0
offset_right = 400.0
offset_bottom = 36.0
mouse_filter = 2
text = "Nothing selected"

[node name="Help" type="Label" parent="Hud"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -150.0
offset_right = 900.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "Left: select (drag: box, Shift: add, Ctrl/Cmd or double click: same kind)   Right: order (hold: radial menu)
A / G / M: arm attack / guard / move, then left click   R: retreat to the hero   Alt+1..8: formation   Tab (hold): radial menu at the pointer
Ctrl/Cmd+1..0: store a group   1..0: recall   Shift+1..0: add to it
Arrows / screen edges / middle drag: pan   Q / E: turn   Wheel: zoom   F: follow the hero / free camera"

[node name="RadialMenu" parent="Hud" instance=ExtResource("16_menu")]

[node name="Cue" parent="Hud" node_paths=PackedStringArray("state", "probe") instance=ExtResource("17_cue")]
state = NodePath("../../Rig/Command/State")
cues = SubResource("Resource_cues")
probe = NodePath("../../Rig/Command/Probe")

[editable path="Rig"]
