[node name="Soldier5" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(-60, 200)

[node name="Soldier6" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(60, 200)

[node name="Camera" type="Camera2D" parent="." node_paths=PackedStringArray("edge_area")]
