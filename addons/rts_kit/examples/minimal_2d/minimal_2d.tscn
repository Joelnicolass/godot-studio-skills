border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.4, 1, 0.5, 0.9)

[node name="Minimal2D" type="Node2D"]
editor_description = "RtsKit's minimal example: six soldiers (soldier.tscn: a body, an RtsUnit, a script that walks to the order's spot) and the command rig of GUIDE.md › 3, every socket wired in the inspector. Drag a box over the soldiers, right click the ground: they go in a line. World units are pixels here, so Orders and Selection have their distances in pixels."

[node name="Units" type="Node2D" parent="."]

[node name="Soldier1" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(-90, 140)

[node name="Soldier2" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(-30, 140)

[node name="Soldier3" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(30, 140)

[node name="Soldier4" parent="Units" instance=ExtResource("1_soldier")]
