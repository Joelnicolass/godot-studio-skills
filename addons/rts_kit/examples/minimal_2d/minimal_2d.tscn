[node name="Minimal2D" type="Node2D"]
editor_description = "RtsKit's minimal example: six soldiers (soldier.tscn: a body, an RtsUnit, a script that walks to the order's spot), a camera and the kit's command rig (rts_command_rig_2d.tscn) with its Camera socket assigned. Drag a box over the soldiers, right click the ground: they go in a line. World units are pixels here: the 2D rig has its distances in pixels."

[node name="Units" type="Node2D" parent="."]

[node name="Soldier1" parent="Units" instance=ExtResource("1_soldier")]
position = Vector2(-90, 140)

