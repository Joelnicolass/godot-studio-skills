[node name="Hud" type="CanvasLayer" parent="."]

[node name="View" type="Control" parent="Hud"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="Panel" parent="Hud/View"]
visible = false
layout_mode = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_box")

[node name="Help" type="Label" parent="Hud"]
offset_left = 16.0
offset_top = 12.0
offset_right = 900.0
offset_bottom = 60.0
mouse_filter = 2
text = "Drag a box over the soldiers (or click one), then right click the ground: they go in a line.
Ctrl/Cmd+1 keeps the selection as group 1; 1 brings it back. Arrows pan."
