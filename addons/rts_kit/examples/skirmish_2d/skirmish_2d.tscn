[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://addons/rts_kit/examples/skirmish_2d/skirmish_2d.gd" id="1_main"]
[ext_resource type="Script" path="res://addons/rts_kit/camera/rts_camera_2d.gd" id="2_camera"]
[ext_resource type="Script" path="res://addons/rts_kit/ui/ping/rts_ping_2d.gd" id="3_ping"]
[ext_resource type="Script" path="res://addons/rts_kit/ui/cue/rts_cue_set.gd" id="15_cues"]
[ext_resource type="Script" path="res://addons/rts_kit/ui/card/rts_command_card.gd" id="16_card"]
[ext_resource type="PackedScene" path="res://addons/rts_kit/ui/cue/rts_command_cue.tscn" id="17_cue"]
[ext_resource type="PackedScene" path="res://addons/rts_kit/rig/rts_command_rig_2d.tscn" id="20_rig"]

[sub_resource type="Resource" id="Resource_cues"]
script = ExtResource("15_cues")

[node name="Skirmish2D" type="Node2D"]
editor_description = "RtsKit's 2D example, with no radial menu: the right button is a plain right click and the command panel gives every order with the mouse. Rig: the kit's command rig (rts_command_rig_2d.tscn) with its Camera socket assigned; Editable Children is on to give State its cues, to end the ground at the map's edge (Pointer) and to wire the HUD to the pieces. Units: spawned by the script (RtsUnit + RtsExampleWalker). Hud comes after the rig, so its panel keeps its clicks."
script = ExtResource("1_main")

[node name="Units" type="Node2D" parent="."]

[node name="Camera" type="Camera2D" parent="."]
script = ExtResource("2_camera")
bounds = Rect2(-1000, -600, 2000, 1200)

[node name="Ping" type="Node2D" parent="." node_paths=PackedStringArray("order_input")]
script = ExtResource("3_ping")
order_input = NodePath("../Rig/Command/OrderInput")

[node name="Rig" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("20_rig")]
camera = NodePath("../Camera")

[node name="Pointer" parent="Rig/Command" index="2"]
ground_bounds_2d = Rect2(-1000, -600, 2000, 1200)

[node name="State" parent="Rig/Command" index="3"]
cues = SubResource("Resource_cues")

[node name="Hud" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="Hud"]
unique_name_in_owner = true
offset_left = 16.0
offset_top = 12.0
offset_right = 400.0
offset_bottom = 36.0
mouse_filter = 2
text = "Nothing selected"

[node name="Help" type="Label" parent="Hud"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -170.0
offset_right = 800.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "Left: select (drag: box, Shift: add, Ctrl/Cmd or double click: same kind)
Right: order   Panel (bottom right): every order with the mouse
A / G / M: arm attack / guard / move, then left click   R: retreat   Alt+1..8: formation
Ctrl/Cmd+1..0: store a group   1..0: recall   Shift+1..0: add to it
Arrows / screen edges / middle drag: pan   Wheel: zoom   F: follow the hero / free camera"

[node name="CommandCard" type="GridContainer" parent="Hud" node_paths=PackedStringArray("order_input", "command_input")]
editor_description = "The kit's command panel: a button per command and formation of the catalogs, with its key. The no-menu way to give every order with the mouse."
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -380.0
offset_top = -250.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0
columns = 3
script = ExtResource("16_card")
order_input = NodePath("../../Rig/Command/OrderInput")
command_input = NodePath("../../Rig/Command")


[node name="Cue" parent="Hud" node_paths=PackedStringArray("state", "probe") instance=ExtResource("17_cue")]
state = NodePath("../../Rig/Command/State")
cues = SubResource("Resource_cues")
probe = NodePath("../../Rig/Command/Probe")

[editable path="Rig"]
