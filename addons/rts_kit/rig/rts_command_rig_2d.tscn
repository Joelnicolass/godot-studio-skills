[node name="RtsCommandRig2D" type="Node"]
editor_description = "RtsKit's command rig for a 2D battle, every piece wired. Instance it, assign Camera and Ground on this node, and the player selects and orders. Right click > Editable Children to change a piece (Command/Orders, Command/Selection…) or to wire a HUD to it. World units are pixels: Orders and Selection have their distances in pixels."
script = ExtResource("1_rig")
dimension = 2

[node name="Command" type="Node" parent="." node_paths=PackedStringArray("selection", "orders", "pointer", "armed", "state", "order_input", "select_input", "group_keys", "order_button")]
