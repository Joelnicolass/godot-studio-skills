; CommandKit lab: a tiny project that runs the kit's own example and tests, apart from any game.
; addons/command_kit is a symlink to the kit's own addons/command_kit (one copy of the kit).

config_version=5

[application]

config/name="CommandKit Lab"
run/main_scene="res://addons/command_kit/examples/minimal/minimal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/command_kit/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
